{
  "name": "dsh-wake",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "尾波：一轮说完后，如果一段时间没人回复，就顺着语境自己再续一小段；空闲时还会安静地想想当前事情或一个新话题（随机区间、最近三条的关键词/模型收尾判断、概率闸）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wake",
    "continue",
    "idle",
    "followup",
    "ai-companion"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
